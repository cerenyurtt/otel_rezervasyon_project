@model OtelRezervasyonProject.Models.Oda

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-warning py-3">
                    <h4 class="mb-0 text-dark text-center fw-bold">Oda Bilgilerini Güncelle</h4>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="OdaNo" class="form-label fw-semibold">Oda Numarası</label>
                            <input asp-for="OdaNo" class="form-control rounded-3" />
                            <span asp-validation-for="OdaNo" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="OdaTipiId" class="form-label fw-semibold">Oda Tipi</label>
                            <select asp-for="OdaTipiId" class="form-select rounded-3" asp-items="ViewBag.OdaTipiId"></select>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="GecelikFiyat" class="form-label fw-semibold">Gecelik Fiyat (TL)</label>
                            <input asp-for="GecelikFiyat" class="form-control rounded-3" type="number" />
                            <span asp-validation-for="GecelikFiyat" class="text-danger small"></span>
                        </div>

                        <div class="form-check form-switch mb-4 mt-3">
                            <input class="form-check-input" type="checkbox" asp-for="MusaitMi">
                            <label class="form-check-label fw-semibold" asp-for="MusaitMi">Oda Müsaitlik Durumu</label>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                                Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>