@model IEnumerable<OtelRezervasyonProject.Models.OdaTipi>

<div class="container mt-4">
    @* Hata Mesajı Gösterimi *@
    @if (TempData["HataMesaj"] != null)

    {
        <div class="alert alert-danger rounded-4 shadow-sm border-0 mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["HataMesaj"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-secondary">Oda Tipleri</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">Yeni Tip Ekle</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Tip Adı</th>
                    <th>Açıklama</th>
                    <th class="text-end pe-4">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)

                {
                    <tr>
                        <td class="ps-4 fw-bold">@item.Ad</td>
                        <td>@item.Aciklama</td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3">Düzenle</a>
                            @* Silme Onayı *@
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger rounded-pill px-3"
                               onclick="return confirm('@item.Ad tipini silmek istediğinize emin misiniz?')">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>