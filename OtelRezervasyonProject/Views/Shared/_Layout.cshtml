@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Otel Rezervasyon</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    @* Google Fonts ekleyerek yazı tipini modernleştirdik *@
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OtelRezervasyonProject.styles.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa; /* Hafif gri arka plan kartları öne çıkarır */
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar {
            border-bottom: 1px solid rgba(0,0,0,0.05) !important;
            border-bottom-left-radius: 1.5rem;
            border-bottom-right-radius: 1.5rem;
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        /* Footer'ı sayfanın en altına sabitlemek için Flexbox yapısı kullanıyoruz */
        main {
            flex: 1;
        }

        .rounded-4 {
            border-radius: 1.25rem !important;
        }

        /* Gizli Admin Girişi için Stil */
        .admin-secret-link {
            color: inherit;
            text-decoration: none;
            cursor: default;
        }

        /* Nav link hover efekti */
        .nav-link:hover {
            color: #0d6efd !important;
            transition: 0.3s;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3 mb-4 sticky-top">
            <div class="container">
                <a class="navbar-brand text-primary d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="me-2">🏨</span> Otel<span class="text-dark">Rezervasyon</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark px-3" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>

                        @* Admin Yetkisi Kontrolü *@
                        @if (HttpContextAccessor.HttpContext.Session.GetString("UserRole") == "Admin")

                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-bold px-3" asp-controller="OdaTipi" asp-action="Index">Oda Tipleri</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-bold px-3" asp-controller="Oda" asp-action="Index">Odaları Yönet</a>
                            </li>
                            @* HOCANIN ŞARTI: Log Listesi Linki *@
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold px-3" asp-controller="Oda" asp-action="LogListesi">
                                    <i class="bi bi-shield-lock me-1"></i>Sistem Logları
                                </a>
                            </li>
                        }

                        @* Giriş yapmış kullanıcı kontrolü *@
                        @if (HttpContextAccessor.HttpContext.Session.GetInt32("UserId") != null)

                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark px-3" asp-controller="Rezervasyon" asp-action="Index">
                                    @(HttpContextAccessor.HttpContext.Session.GetString("UserRole") == "Admin" ? "Tüm Rezervasyonlar" : "Rezervasyonlarım")
                                </a>
                            </li>
                        }
                    </ul>

                    @* Sağ Taraftaki Kullanıcı Menüsü *@
                    <div class="d-flex align-items-center">
                        @if (HttpContextAccessor.HttpContext.Session.GetInt32("UserId") != null)

                        {
                            <div class="d-flex align-items-center bg-light rounded-pill px-3 py-1 me-2 border shadow-sm">
                                <span class="text-muted small me-2 d-none d-md-inline">Hoş geldin,</span>
                                <span class="fw-bold small text-dark">@HttpContextAccessor.HttpContext.Session.GetString("UserName")</span>
                                <span class="badge @(HttpContextAccessor.HttpContext.Session.GetString("UserRole") == "Admin" ? "bg-danger" : "bg-success") ms-2 rounded-pill">
                                    @HttpContextAccessor.HttpContext.Session.GetString("UserRole")
                                </span>
                            </div>
                            <a class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm fw-bold" asp-controller="Account" asp-action="Logout" title="Çıkış Yap">
                                <i class="bi bi-box-arrow-right"></i>
                            </a>
                        }

                        else

                        {
                            <a class="btn btn-link text-dark text-decoration-none fw-semibold me-2" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                            <a class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm fw-bold" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-5 rounded-top-5 shadow-lg mt-auto">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <span class="text-muted">
                        @* Admin Girişine giden gizli link © işaretinde *@
                        <a asp-controller="Account" asp-action="AdminLogin" class="admin-secret-link">&copy;</a>
                        2026 - <span class="fw-bold text-dark">OtelRezervasyonProject</span>
                    </span>
                </div>
                <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">
                    <a class="text-decoration-none text-muted small me-3" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
                    <a href="#" class="text-muted me-3"><i class="bi bi-instagram fs-5"></i></a>
                    <a href="#" class="text-muted me-3"><i class="bi bi-facebook fs-5"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-twitter-x fs-5"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>