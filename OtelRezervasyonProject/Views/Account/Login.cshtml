@model OtelRezervasyonProject.ViewModels.LoginVM

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary py-4 text-center">
                    <h3 class="text-white fw-bold mb-0">Hoş Geldiniz</h3>
                    <p class="text-white-50 small mb-0">Hesabınıza giriş yaparak devam edin</p>
                </div>
                <div class="card-body p-5">
                    @if (ViewBag.Hata != null)

                    {
                        <div class="alert alert-danger rounded-3 small">@ViewBag.Hata</div>
                    }

                    <form asp-action="Login" method="post">
                        <div class="form-group mb-4">
                            <label asp-for="Email" class="form-label fw-semibold">E-Posta Adresi</label>
                            <input asp-for="Email" class="form-control rounded-3 border-2" placeholder="email@otel.com" required />
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Sifre" class="form-label fw-semibold">Şifre</label>
                            <input asp-for="Sifre" type="password" class="form-control rounded-3 border-2" placeholder="••••••••" required />
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                                Giriş Yap
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <span class="text-muted small">Hesabınız yok mu?</span>
                        <a asp-action="Register" class="text-primary fw-bold small text-decoration-none ms-1">Hemen Kayıt Ol</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>