@model OtelRezervasyonProject.ViewModels.KayitVM

@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-success py-4 text-center">
                    <h3 class="text-white fw-bold mb-0">Yeni Üyelik Oluştur</h3>
                    <p class="text-white-50 small mb-0">Ayrıcalıklı tatil fırsatları için aramıza katılın</p>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Ad" class="form-label fw-semibold">Ad</label>
                                <input asp-for="Ad" class="form-control rounded-3 border-2" placeholder="Adınız" />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="Soyad" class="form-label fw-semibold">Soyad</label>
                                <input asp-for="Soyad" class="form-control rounded-3 border-2" placeholder="Soyadınız" />
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Email" class="form-label fw-semibold">E-Posta</label>
                            <input asp-for="Email" class="form-control rounded-3 border-2" placeholder="ornek@mail.com" />
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Sifre" class="form-label fw-semibold">Şifre</label>
                            <input asp-for="Sifre" type="password" class="form-control rounded-3 border-2" placeholder="En az 6 karakter" />
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold shadow-sm">
                                Üyeliği Tamamla
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <span class="text-muted small">Zaten üye misiniz?</span>
                        <a asp-action="Login" class="text-success fw-bold small text-decoration-none ms-1">Giriş Yap</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>