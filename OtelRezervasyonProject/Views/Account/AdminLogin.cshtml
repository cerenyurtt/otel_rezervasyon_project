@model OtelRezervasyonProject.ViewModels.LoginVM

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                @* Admin Paneli İçin Koyu Tema Başlık *@
                <div class="card-header bg-dark py-4 text-center">
                    <h4 class="text-white fw-bold mb-0"><i class="bi bi-shield-lock me-2"></i>Yönetici Paneli</h4>
                    <p class="text-white-50 small mb-0">Lütfen yetkili bilgileriyle giriş yapın</p>
                </div>
                <div class="card-body p-5">
                    @if (ViewBag.Hata != null)

                    {
                        <div class="alert alert-danger rounded-3 small border-0 shadow-sm">@ViewBag.Hata</div>
                    }

                    <form asp-action="AdminLogin" method="post">
                        <div class="form-group mb-4">
                            <label class="form-label fw-bold small text-secondary">ADMİN E-POSTA</label>
                            <input asp-for="Email" class="form-control rounded-3 border-2 py-2" placeholder="admin@otel.com" required />
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label fw-bold small text-secondary">GÜVENLİ ŞİFRE</label>
                            <input asp-for="Sifre" type="password" class="form-control rounded-3 border-2 py-2" placeholder="••••••••" required />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark btn-lg rounded-pill fw-bold shadow-sm py-2">
                                Paneli Aç
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="text-center mt-3">
                <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Siteye Geri Dön
                </a>
            </div>
        </div>
    </div>
</div>