
@model OtelRezervasyonProject.ViewModels.OdaAramaVM

@* 1. Hero Bölümü: Arkaplan resmi ve modern arama formu *@
<div class="hero-section text-white text-center py-5 mb-5 rounded-4 shadow"
     style="background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1571896349842-33c89424de2d?q=80&w=1920&auto=format&fit=crop'); background-size: cover; background-position: center;">
    <div class="container py-4">
        <h1 class="display-5 fw-bold mb-4">Hayalinizdeki Tatili Ayarlayın</h1>

        @* Arama Formu Konteynırı *@
        <div class="card border-0 shadow-lg mx-auto overflow-hidden rounded-4" style="max-width: 1100px; background: rgba(255, 255, 255, 0.95);">
            <div class="card-body p-4 text-start">
                @* Yazıları sola yasladık *@
                <form asp-action="OdaAra" method="get">
                    <div class="row g-2 align-items-end">
                        @* Giriş Tarihi *@
                        <div class="col-md-2">
                            <label class="form-label text-dark fw-semibold small">Giriş Tarihi</label>
                            <input type="date" asp-for="GirisTarihi" class="form-control rounded-3"
                                   value="@(Model.GirisTarihi == default ? DateTime.Now.ToString("yyyy-MM-dd") : Model.GirisTarihi.ToString("yyyy-MM-dd"))" />
                        </div>

                        @* Çıkış Tarihi *@
                        <div class="col-md-2">
                            <label class="form-label text-dark fw-semibold small">Çıkış Tarihi</label>
                            <input type="date" asp-for="CikisTarihi" class="form-control rounded-3"
                                   value="@(Model.CikisTarihi == default ? DateTime.Now.AddDays(1).ToString("yyyy-MM-dd") : Model.CikisTarihi.ToString("yyyy-MM-dd"))" />
                        </div>

                        @* Min Fiyat *@
                        <div class="col-md-2">
                            <label class="form-label text-dark fw-semibold small">Min Fiyat</label>
                            <input type="number" asp-for="MinFiyat" class="form-control rounded-3" placeholder="0"
                                   value="@(Model.MinFiyat > 0 ? Model.MinFiyat : "")" />
                        </div>

                        @* Max Fiyat *@
                        <div class="col-md-2">
                            <label class="form-label text-dark fw-semibold small">Max Fiyat</label>
                            <input type="number" asp-for="MaxFiyat" class="form-control rounded-3" placeholder="10.000"
                                   value="@(Model.MaxFiyat > 0 ? Model.MaxFiyat : "")" />
                        </div>

                        @* Oda Tipi *@
                        <div class="col-md-2">
                            <label class="form-label text-dark fw-semibold small">Oda Tipi</label>
                            <select asp-for="SecilenOdaTipiId" class="form-select rounded-3" asp-items="ViewBag.OdaTipleri">
                                <option value="">Tüm Tipler</option>
                            </select>
                        </div>

                        @* Arama Butonu *@
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100 rounded-3 py-2 fw-bold shadow-sm">
                                <i class="bi bi-search me-1"></i> Listele
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* 2. Oda Listeleme Bölümü *@
<div class="container mb-5">
    <h3 class="fw-bold mb-4 text-secondary text-center">Size Uygun Müsait Odalar</h3>

    @if (Model.BulunanOdalar != null && Model.BulunanOdalar.Any())

    {
        <div class="row g-4">
            @foreach (var oda in Model.BulunanOdalar)

            {
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover-effect">
                        @* Oda Resmi *@
                        <div style="height: 220px; overflow: hidden;">
                            <img src="https://images.unsplash.com/photo-1631049307264-da0ec9d70304?q=80&w=800&auto=format&fit=crop"
                                 class="card-img-top h-100 w-100" style="object-fit: cover;" alt="Oda Resmi">
                        </div>

                        <div class="card-body p-4 text-center d-flex flex-column">
                            @* Oda Tipi Badge *@
                            <span class="badge bg-primary bg-opacity-10 text-primary mb-2 px-3 py-2 align-self-center rounded-pill">
                                @(oda.OdaTipi?.Ad ?? "Standart Oda")
                            </span>

                            <h4 class="card-title fw-bold mb-1">Oda No: @oda.OdaNo</h4>
                            <p class="text-muted small mb-3">Konforlu konaklama seçeneği</p>

                            <div class="d-flex justify-content-center align-items-baseline mb-4">
                                <span class="h3 fw-bold text-dark mb-0">@oda.GecelikFiyat.ToString("N0") TL</span>
                                <span class="text-muted ms-1">/ gece</span>
                            </div>

                            @* Rezervasyon Butonu *@
                            <div class="mt-auto pt-3">
                                <a asp-controller="Rezervasyon" asp-action="RezerveEt"
                                   asp-route-id="@oda.Id"
                                   asp-route-giris="@Model.GirisTarihi.ToString("yyyy-MM-dd")"
                                   asp-route-cikis="@Model.CikisTarihi.ToString("yyyy-MM-dd")"
                                   class="btn btn-success w-100 py-2 fw-bold rounded-pill shadow-sm transition-hover">
                                    <i class="bi bi-calendar-check me-1"></i> Hemen Rezerve Et
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    else if (Model.BulunanOdalar != null)

    {
        <div class="text-center py-5">
            <div class="alert alert-light border rounded-4 p-5 shadow-sm">
                <i class="bi bi-exclamation-circle text-warning display-4 mb-3"></i>
                <h5 class="text-muted">Aradığınız kriterlere uygun müsait oda bulunamadı.</h5>
                <p class="mb-0">Lütfen farklı bir tarih veya fiyat aralığı seçiniz.</p>
            </div>
        </div>
    }
</div>

@* Stil Tanımlamaları *@
<style>
    .rounded-4 {
        border-radius: 1.25rem !important;
    }

    .card-hover-effect {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card-hover-effect:hover {
            transform: translateY(-10px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,0.15) !important;
        }

    .transition-hover {
        transition: 0.2s;
    }

        .transition-hover:hover {
            opacity: 0.9;
            transform: scale(1.02);
        }
</style>